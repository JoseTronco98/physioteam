# One of these two keys is required. The app looks for .env in this folder first,
# then in the folder above it (where the teaching staff keep theirs).
PORTKEY_API_KEY=
OPENAI_API_KEY=

# Optional
# MODEL_NAME=gpt-6-luna
# SESSION_CAP_USD=0.75          # AI budget per visitor (browser session)
# GLOBAL_DAILY_CAP_USD=8.00     # AI budget per day across all visitors
# ACCESS_CODE=                  # if set, visitors must type this code (useful when hosted publicly)

# Optional: live WhatsApp test (see docs/whatsapp_live.md)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ALLOWED=+52 55 1111 2222   # comma-separated test phones; everyone else is ignored
